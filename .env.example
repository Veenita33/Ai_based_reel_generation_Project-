# Copy this file to ".env" and fill in your own values for local development.
# NEVER commit your real .env file - it is already in .gitignore.

# A random long string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- ElevenLabs -----------------------------------------------------------
# Get your key at https://elevenlabs.io -> profile icon -> "API Keys"
ELEVENLABS_API_KEY=

# Voice to narrate with. Default below = ElevenLabs' built-in "Rachel" voice.
# Find other voice IDs at https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# TTS model to use.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Gemini (AI narration) ------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey . Without it the app still works; the
# "Generate AI Narration" button is disabled and users write their script by hand.
GEMINI_API_KEY=
# Any Gemini model that accepts image + video + audio input.
GEMINI_MODEL=gemini-3.8-flash
# Max seconds for one narration run (upload + analysis + writing).
# Fallback model, if your code supports model switching
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT_SECONDS=240

# --- Database ---------------------------------------------------------------
# Leave unset to use a local SQLite file (fine for small/personal deployments).
# On Render, you can point this at a managed Postgres instance instead:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=

# Optional: voices offered in the create form, "Name:voice_id,Name:voice_id".
# Leave unset to use the built-in list (ELEVENLABS_VOICE_ID is always listed first).
# ELEVENLABS_VOICES=Rachel:21m00Tcm4TlvDq8ikWAM,Adam:pNInz6obpgDQGcFmaJgB

# --- Storage & free trial -------------------------------------------------------
# Private reel storage (outside static/). On Render, point this at the mounted disk.
# REEL_STORAGE_DIR=./storage
# Free reels an anonymous visitor gets before they must sign in.
GUEST_FREE_REELS=1
# Also recognise guests by hashed IP (stops cookie-clearing/incognito resets).
# Set to 0 if many visitors share one public IP (school/office networks).
GUEST_TRACK_BY_IP=1
# Trust X-Forwarded-For from your host's proxy (needed for correct IPs on Render/Heroku).
TRUST_PROXY=1
# Set to 1 in production (HTTPS only cookies).
SESSION_COOKIE_SECURE=0

# Max upload size per request, in megabytes
MAX_CONTENT_LENGTH_MB=200
# Per-file limits (MB) and number of files per reel
# MAX_VIDEO_MB=150
# MAX_IMAGE_MB=20
# MAX_AUDIO_MB=50
# MAX_MEDIA_FILES=20
# Hours uploaded media is kept for editing/re-rendering a narration before it is deleted
# DRAFT_TTL_HOURS=24
